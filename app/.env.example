# ---- NutriScan API (server only; never bundle into the app) ----
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:nutriscan@127.0.0.1:54329/nutriscan

# Supabase project URL (Auth tokens are verified against its JWKS)
SUPABASE_URL=
# Local development only: verify HS256 tokens signed with this secret
DEV_JWT_SECRET=dev-only-change-me

# AI through OpenRouter (https://openrouter.ai/keys). Free models are tried first; a cheap paid
# model is the last fallback. Buy 10 USD of credits once: free models then allow 1000 requests
# a day instead of 50 (OpenRouter limits page).
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-v4.1-flash
OPENROUTER_DEEP_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-v4.1-flash
OPENROUTER_VISION_MODELS=nvidia/nemotron-3.5-super-vl:free,qwen/qwen3.7-flash
# deny = only providers that do not store or train on prompts (health data). No free endpoint
# qualified on 27 Nov 2026, so deny means the paid backup answers. allow = free models work.
OPENROUTER_DATA_COLLECTION=deny
AI_MONTHLY_BUDGET_USD=5

# Team members who can approve recalls and review contributions (Supabase user ids)
ADMIN_USER_IDS=

# ---- AppLink (same names as the official AppLink templates) ----
APPLINK_APP_ID=
APPLINK_PASSWORD=
# Uncomment only what is enabled on our AppLink app. For local development point them at the
# mock: node ~/.claude/plugins/cache/applink/applink/1.0.0/scripts/mock-applink.mjs (port 8089)
#APPLINK_SMS_SEND_URL=https://api.applink.com.bd/sms/send
#APPLINK_USSD_SEND_URL=https://api.applink.com.bd/ussd/send
#APPLINK_SUBSCRIPTION_SEND_URL=https://api.applink.com.bd/subscription/send
#APPLINK_SUBSCRIPTION_QUERY_BASE_URL=https://api.applink.com.bd/subscription/query-base
#APPLINK_SUBSCRIPTION_CHARGING_INFO_URL=https://api.applink.com.bd/subscription/getSubscriberChargingInfo
#APPLINK_OTP_REQUEST_URL=https://api.applink.com.bd/otp/request
#APPLINK_OTP_VERIFY_URL=https://api.applink.com.bd/otp/verify
#APPLINK_CAAS_DEBIT_URL=https://api.applink.com.bd/caas/direct/debit
#APPLINK_CAAS_OTP_VERIFY_URL=https://api.applink.com.bd/caas/otp/verify
# AppLink callback source IPs (ask support@applink.com.bd). Empty allows all: development only.
APPLINK_CALLBACK_ALLOWED_IPS=
APPLINK_SMS_SHORTCODE=
APPLINK_USSD_CODE=

# ---- App (public, bundled into the Expo app) ----
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
